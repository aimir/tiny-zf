/-! # Exact placement of the structured source in its primitive graph

Generated witnesses are checked against every actual register instruction,
branch, loop back-edge, and control-only jump. Each private lemma covers one
meaningful interpreter phase; `models` composes them into the whole iteration.
The Python matcher and source compiler are not trusted. -/
namespace TinyZF.Interpreter.Placement
open Graph

/-- Literal placement of the enumeration phase, from entry 0 to normal return 10. -/
private theorem place_enumeration (breaks : Nat → Fin 6741) :
    Models SourceGraph.program breaks (Decoding.enumerationPrefix) 0 10 := by
  apply Models.ifDec (actual := 0) (yes := 1) (no := 2) (Jumps.done _) (by decide +kernel)
  ·
    exact Models.skip (checkJumps_sound _ 1 [10] 10 (by decide +kernel))
  ·
    apply Models.seq (mid := 6)
    ·
      apply Models.whileDec (actual := 2) (bodyEntry := 3) (zero := 6) (Jumps.done _) (by decide +kernel) (Jumps.done _)
      apply Models.seq (mid := 4)
      ·
        exact Models.inc (Jumps.done _) (by decide +kernel) (Jumps.done _)
      ·
        apply Models.seq (mid := 2)
        ·
          exact Models.inc (Jumps.done _) (by decide +kernel) (checkJumps_sound _ 5 [2] 2 (by decide +kernel))
        ·
          exact Models.skip (Jumps.done _)
    ·
      apply Models.seq (mid := 9)
      ·
        apply Models.whileDec (actual := 6) (bodyEntry := 7) (zero := 9) (Jumps.done _) (by decide +kernel) (Jumps.done _)
        apply Models.seq (mid := 6)
        ·
          exact Models.inc (Jumps.done _) (by decide +kernel) (checkJumps_sound _ 8 [6] 6 (by decide +kernel))
        ·
          exact Models.skip (Jumps.done _)
      ·
        exact Models.inc (Jumps.done _) (by decide +kernel) (Jumps.done _)

